# EarthWatch AI Root .gitignore
# Environment & secrets — NEVER commit
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Dependencies & Build artifacts
node_modules/
**/node_modules/
dist/
**/dist/

# Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
**/venv/
.venv/
**/ .venv/

# Local databases & registries & satellite downloads
*.db
*.sqlite
data/*.db
data/*.sqlite
backend/data/sentinel1/
**/data/sentinel1/

# Logs & temporary files
*.log
scratch/
**/scratch/
.DS_Store
.idea/
.vscode/
