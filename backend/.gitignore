# EarthWatch AI — Backend .gitignore
# Credentials and environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/

# Local data / registries / satellite downloads
data/*.db
data/*.sqlite
data/sentinel1/
data/sentinel1/processed/
data/sentinel1/flood_detection/

# Satellite rasters, archives & temp files — NEVER commit
*.tif
*.tiff
*.SAFE
*.SAFE/
*.zip
*.part

# Logs
*.log
